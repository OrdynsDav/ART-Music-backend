# OAuth-токен Яндекс.Музыки (опционально, для dev/скриптов; обычно вход через /auth/login)
YANDEX_MUSIC_TOKEN=

# Секрет для подписи session-cookie (обязательно сменить в production)
SESSION_SECRET=change-me-to-a-long-random-string

# Порт HTTP-сервера (не 3000 — его часто занимает Neutralino)
PORT=3001

# Язык ответов API Яндекса: ru, en, uk, …
YANDEX_MUSIC_LANGUAGE=ru

# CORS для фронта (Vite и т.д.), через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Разрешить любой origin (только для разработки)
# CORS_ALLOW_ALL=true

# Обмен x-token → music token (Device Flow). Без секрета используйте /auth/login в WebView.
# MUSIC_OAUTH_CLIENT_ID=23cabbbdc6cd418abb4b39c32c41195d
# MUSIC_OAUTH_CLIENT_SECRET=

# OAuth-приложение на https://oauth.yandex.ru (тип «Веб-сервисы»).
# Callback URL: http://127.0.0.1:3001/auth/callback
# Без этих переменных используются встроенные креды Passport SDK.
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/auth/callback
